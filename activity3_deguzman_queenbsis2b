<?php
// Enable error reporting
ini_set('display_errors', 1);
ini_set('display_startup_errors', 1);
error_reporting(E_ALL);

// 1. Subject Grades
$deguzman_math = 88;
$deguzman_science = 92;
$deguzman_english = 85;
$deguzman_history = 78;
$deguzman_programming = 90;

// 2. Compute Average
$deguzman_total = $deguzman_math + $deguzman_science + $deguzman_english + $deguzman_history + $deguzman_programming;
$deguzman_average = $deguzman_total / 5;

// 3. Determine Remarks
if ($deguzman_average >= 74.5) {
    $deguzman_remarks = "Passed";
} else {
    $deguzman_remarks = "Failed";
}

// 4. Determine Letter Grade
if ($deguzman_average >= 90 && $deguzman_average <= 100) {
    $deguzman_letter_grade = "A";
} elseif ($deguzman_average >= 80 && $deguzman_average < 90) {
    $deguzman_letter_grade = "B";
} elseif ($deguzman_average >= 70 && $deguzman_average < 80) {
    $deguzman_letter_grade = "C";
} elseif ($deguzman_average >= 60 && $deguzman_average < 70) {
    $deguzman_letter_grade = "D";
} elseif ($deguzman_average >= 0 && $deguzman_average < 60) {
    $deguzman_letter_grade = "F";
} else {
    $deguzman_letter_grade = "Invalid Grade";
}

// 5. Display Output
echo "<h2>Grade Evaluator</h2>";
echo "<p><b>Subject Grades:</b></p>";
echo "<ul>";
echo "<li>Math: " . $deguzman_math . "</li>";
echo "<li>Science: " . $deguzman_science . "</li>";
echo "<li>English: " . $deguzman_english . "</li>";
echo "<li>History: " . $deguzman_history . "</li>";
echo "<li>Programming: " . $deguzman_programming . "</li>";
echo "</ul>";
echo "<hr>";
echo "<p><b>Average Grade:</b> " . number_format($deguzman_average, 2) . "</p>";
echo "<p><b>Remarks:</b> " . $deguzman_remarks . "</p>";
echo "<p><b>Letter Grade:</b> " . $deguzman_letter_grade . "</p>";
?>
